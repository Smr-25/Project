@model RestaurantApp.Application.Dtos.Dashboard.DashboardDto
@{
    ViewData["Title"] = "Operations dashboard";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">Today at a glance</p>
            <h1 class="display-6 mb-0">Restaurant operations</h1>
        </div>
        <a asp-controller="Order" asp-action="Create" class="btn btn-dark">Create order</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-muted small">Revenue</p><p class="h3 mb-0">@Model.TodayRevenue.ToString("N2") AZN</p></div></div></div>
        <div class="col-6 col-xl"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-muted small">Orders</p><p class="h3 mb-0">@Model.TodayOrderCount</p></div></div></div>
        <div class="col-6 col-xl"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-muted small">Active orders</p><p class="h3 mb-0">@Model.ActiveOrderCount</p></div></div></div>
        <div class="col-6 col-xl"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-muted small">Average ticket</p><p class="h3 mb-0">@Model.AverageTicket.ToString("N2") AZN</p></div></div></div>
        <div class="col-6 col-xl"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-muted small">Occupied tables</p><p class="h3 mb-0">@Model.OccupiedTableCount</p></div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between"><strong>Recent orders</strong><a asp-controller="Order" asp-action="List">View all</a></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Order</th><th>Table</th><th>Status</th><th>Total</th><th>Time</th></tr></thead>
                        <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr><td><a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">@order.Number</a></td><td>@(order.TableNumber ?? "—")</td><td><span class="badge text-bg-light">@order.Status</span></td><td>@order.TotalAmount.ToString("N2") AZN</td><td>@order.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</td></tr>
                        }
                        @if (Model.RecentOrders.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No orders yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Top-selling items</strong></div>
                <ol class="list-group list-group-numbered list-group-flush">
                    @foreach (var item in Model.TopSellingItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center"><span>@item.Name <small class="d-block text-muted">@item.Revenue.ToString("N2") AZN</small></span><span class="badge text-bg-dark rounded-pill">@item.Quantity</span></li>
                    }
                </ol>
            </div>
        </div>
    </div>
</section>
