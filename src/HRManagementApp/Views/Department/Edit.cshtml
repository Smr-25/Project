@model HRManagementApp.Models.EditDepartmentViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Edit Department</h2>
        
        <form asp-action="Edit" method="post" class="card shadow-sm p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

            <input type="hidden" asp-for="OldName" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Old Name</label>
                <input class="form-control" value="@Model.OldName" disabled />
            </div>

            <div class="mb-4">
                <label asp-for="NewName" class="form-label fw-semibold">New Name</label>
                <input asp-for="NewName" class="form-control" placeholder="New department name..." />
                <span asp-validation-for="NewName" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back</a>
                <button type="submit" class="btn btn-warning px-4">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
