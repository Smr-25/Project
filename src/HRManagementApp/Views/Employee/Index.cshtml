@model IEnumerable<HRManagementApp.Core.Entities.Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employees</h2>
    <a asp-action="Create" class="btn btn-primary">New Employee</a>
</div>

<form method="get" asp-action="Index" class="mb-4 d-flex">
    <input type="text" name="query" value="@ViewBag.SearchQuery" class="form-control me-2" placeholder="Search by name, no, position or department..." />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
    {
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
    }
</form>


<table class="table table-bordered table-striped shadow-sm bg-white">
    <thead class="table-dark">
        <tr>
            <th>No</th>
            <th>Full Name</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if(!Model.Any()) {
            <tr><td colspan="6" class="text-center">No employees found.</td></tr>
        }
        @foreach (var emp in Model)
        {
            <tr>
                <td class="fw-bold text-success">@emp.No</td>
                <td>@emp.FullName</td>
                <td>@emp.Position</td>
                <td>@emp.Salary.ToString("C2")</td>
                <td>@emp.DepartmentName</td>
                <td>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-no="@emp.No" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                            <input type="hidden" name="no" value="@emp.No" />
                            <input type="hidden" name="departmentName" value="@emp.DepartmentName" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
