@model IReadOnlyCollection<RestaurantApp.Application.Dtos.Categories.CategoryReturnDto>
@{
    ViewData["Title"] = "Menu categories";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <p class="text-uppercase text-muted small mb-1">Menu setup</p>
        <h1 class="h2 mb-0">Categories</h1>
    </div>
    <a asp-action="Create" class="btn btn-dark">Add category</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
        <tr>
            <th>Order</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.DisplayOrder</td>
                <td class="fw-semibold">@category.Name</td>
                <td>@category.Description</td>
                <td><span class="badge @(category.IsActive ? "text-bg-success" : "text-bg-secondary")">@(category.IsActive ? "Active" : "Archived")</span></td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this empty category?');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
