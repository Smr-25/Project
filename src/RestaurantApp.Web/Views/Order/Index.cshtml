@{
    ViewData["Title"] = "Order Operations";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Order Operations</h2>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="list-group">
        <a href="@Url.Action("Create", "Order")" class="list-group-item list-group-item-action list-group-item-primary">
            1 - Add New Order
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-danger">
            2 - Cancel Order (from List)
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-info">
            3 - Show All Orders
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-secondary">
            4 - Show Orders by Date Range (Filter on List)
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-secondary">
            5 - Show Orders by Amount Range (Filter on List)
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-secondary">
            6 - Show Orders on Exact Date (Filter on List)
        </a>
        <a href="@Url.Action("List", "Order")" class="list-group-item list-group-item-action list-group-item-secondary">
            7 - Show Order Details by No (Details on List)
        </a>
        <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action list-group-item-dark">
            0 - Return to Main Menu
        </a>
    </div>
</div>

