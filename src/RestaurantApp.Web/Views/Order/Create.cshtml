@model RestaurantApp.Application.Dtos.Orders.OrderCreateDto

@{
    ViewData["Title"] = "Add New Order";
    var menuItems = ViewBag.MenuItems as List<RestaurantApp.Application.Dtos.MenuItems.MenuItemReturnDto> ?? new List<RestaurantApp.Application.Dtos.MenuItems.MenuItemReturnDto>();
    if (Model.OrderItems.Count == 0)
    {
        for (var i = 0; i < 5; i++)
        {
            Model.OrderItems.Add(new RestaurantApp.Application.Dtos.OrderItems.OrderItemCreateDto());
        }
    }
}

<div class="container mt-5">
    <h2>Add New Order</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Order notes</label>
            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional note for the team"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <h4>Order Items</h4>
        <p class="text-muted">Select an item and enter count. Leave empty to ignore row.</p>
        
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Menu Item</th>
                    <th>Quantity</th>
                    <th>Special instructions</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.OrderItems.Count; i++)
                {
                    <tr>
                        <td>
                            <select asp-for="OrderItems[i].MenuItemId" class="form-select">
                                <option value="0">-- Select Menu Item --</option>
                                @foreach (var item in menuItems)
                                {
                                    <option value="@item.Id">@item.Name (@item.Price.ToString("C"))</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input asp-for="OrderItems[i].Quantity" type="number" min="0" max="99" class="form-control" />
                        </td>
                        <td>
                            <input asp-for="OrderItems[i].SpecialInstructions" class="form-control" placeholder="Optional" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Create Order</button>
            <a asp-action="Index" class="btn btn-secondary">Back to Order Operations</a>
        </div>
    </form>
</div>
