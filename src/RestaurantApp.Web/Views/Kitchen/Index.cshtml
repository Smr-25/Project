@model IReadOnlyCollection<RestaurantApp.Application.Dtos.Orders.OrderReturnDto>
@{
    ViewData["Title"] = "Kitchen board";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div><p class="text-uppercase text-muted small mb-1">Live service</p><h1 class="h2 mb-0">Kitchen board</h1></div>
    <a asp-action="Index" class="btn btn-outline-dark">Refresh</a>
</div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="row g-3">
    @foreach (var order in Model)
    {
        <div class="col-lg-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-header d-flex justify-content-between">
                    <strong>@order.Number</strong><span class="badge text-bg-dark">@order.Status</span>
                </div>
                <div class="card-body">
                    <p class="text-muted">Table @order.TableNumber · @order.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</p>
                    <ul class="list-unstyled">
                        @foreach (var item in order.OrderItems)
                        {
                            <li class="mb-2"><strong>@item.Quantity×</strong> @item.MenuItemName @if (item.SpecialInstructions is not null) { <small class="d-block text-muted">@item.SpecialInstructions</small> }</li>
                        }
                    </ul>
                    <form asp-action="Advance" asp-route-id="@order.Id" method="post" class="d-inline">
                        <button class="btn btn-success" type="submit">@(order.Status == RestaurantApp.Domain.Models.OrderStatus.Ready ? "Mark served" : "Advance order")</button>
                    </form>
                    <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="mt-2 d-flex gap-2">
                        <input name="reason" class="form-control form-control-sm" placeholder="Cancellation reason" required />
                        <button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button>
                    </form>
                </div>
            </article>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="col-12"><div class="alert alert-light border">No active kitchen orders.</div></div>
    }
</div>
