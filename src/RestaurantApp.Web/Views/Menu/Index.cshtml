@{
    ViewData["Title"] = "Menu Operations";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Menu Operations</h2>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="list-group">
        <a href="@Url.Action("Create", "Menu")" class="list-group-item list-group-item-action list-group-item-primary">
            1 - Add New Menu Item
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-warning">
            2 - Edit Menu Item (from List)
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-danger">
            3 - Delete Menu Item (from List)
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-info">
            4 - Show All Items
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-secondary">
            5 - Show Items by Category (Filter on List)
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-secondary">
            6 - Show Items by Price Range (Filter on List)
        </a>
        <a href="@Url.Action("List", "Menu")" class="list-group-item list-group-item-action list-group-item-secondary">
            7 - Search Items by Name (Search on List)
        </a>
        <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action list-group-item-dark">
            0 - Return to Main Menu
        </a>
    </div>
</div>
