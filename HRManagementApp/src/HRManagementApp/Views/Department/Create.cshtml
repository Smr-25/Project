@model HRManagementApp.Business.DTOs.DepartmentDto
@{
    ViewData["Title"] = "New Department";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Create New Department</h2>
        
        <form asp-action="Create" method="post" class="card shadow-sm p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Department Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. IT, Marketing" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WorkerLimit" class="form-label fw-semibold">Worker Limit</label>
                <input asp-for="WorkerLimit" class="form-control" type="number" min="1" value="1" />
                <span asp-validation-for="WorkerLimit" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="SalaryLimit" class="form-label fw-semibold">Salary Limit (AZN)</label>
                <input asp-for="SalaryLimit" class="form-control" type="number" step="0.01" min="250" value="250" />
                <span asp-validation-for="SalaryLimit" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back</a>
                <button type="submit" class="btn btn-success px-4">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
